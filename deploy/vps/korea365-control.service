[Unit]
Description=Korea365 control center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=korea365
Group=korea365
WorkingDirectory=/opt/korea365
EnvironmentFile=/etc/korea365/control-center.env
ExecStart=/opt/korea365/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --threads 4 control_center.app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
