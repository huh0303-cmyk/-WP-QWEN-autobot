{
  "name": "London WP25 Master",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 13
            }
          ]
        }
      },
      "id": "wp-schedule",
      "name": "Hourly WP25 check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/huh0303-cmyk/-WP-QWEN-autobot/actions/workflows/daily-publication-floor.yml/dispatches",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.N8N_GH_TOKEN}}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"ref\":\"main\",\"inputs\":{\"platform\":\"wordpress\"}}",
        "options": {}
      },
      "id": "wp-dispatch",
      "name": "Dispatch WP25 floor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ]
    }
  ],
  "connections": {
    "Hourly WP25 check": {
      "main": [
        [
          {
            "node": "Dispatch WP25 floor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul"
  },
  "active": false,
  "tags": []
}