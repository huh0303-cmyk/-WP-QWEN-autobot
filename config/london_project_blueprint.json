    "safe_hold": "vps_preserve_state_stop_new_generation_and_unapproved_publication",
    "verified_complete_authority": "deterministic_audit_engine"
  },
  "failover": {
    "pm_chain": ["openai", "anthropic", "gemini", "safe_hold"],
    "audit_summary_chain": ["anthropic", "gemini", "openai"],
    "triggers": ["quota_exhausted", "rate_limit", "timeout", "provider_outage", "authentication_failure", "expired_pm_lease", "repeated_provider_failure"],
    "handoff_required": ["open_tasks", "publishing_schedule", "recent_decisions", "acceptance_criteria", "recent_errors", "audit_failures", "unfinished_assignments", "activity_ledger_cursor"]
  },
  "publishing": {
    "timezone": "Asia/Seoul",
    "schedule_policy_file": "config/london_content_schedule.json",
    "planned_jitter_minutes": 60,
    "forbid_exact_hour": true,
    "minimum_same_platform_gap_minutes": 30,
    "wordpress_general": "1_per_enabled_site_per_day",
    "newsrooms": "rss_breaking_news_target_3_to_10_per_newsroom_per_day_max_10",
    "youtube_playlist": "1_private_production_per_channel_every_2_to_3_days",
    "youtube_knowledge": "1_private_production_per_channel_every_2_to_3_days",
    "survival_10_language": "1_private_lesson_per_language_every_2_to_3_days",
    "survival_lessons_per_language": 50,
    "survival_completed_through_lesson": 2,
    "survival_next_lesson": 3,
    "youtube_private_first": true,
    "chairman_approval_before_review_gated_publication": true,
    "copyright_safe_image_first": true
  },
  "activity_ledger": {
    "every_task_must_be_recorded": true,
    "append_only_event_history": true,
    "record_success_failure_retry_failover_evidence_and_human_approval": true,
    "sqlite": "/opt/korea365/data/control-operations.sqlite3",
    "jsonl": "/opt/korea365/data/london_project_activity.jsonl"
  },
  "truth_model": {
    "states": ["REQUESTED", "PLANNED", "ASSIGNED", "RUNNING", "READY_FOR_AUDIT", "AUDITING", "VERIFIED_PRIVATE", "REVIEW_REQUIRED", "VERIFIED_COMPLETE", "REWORK_REQUIRED", "FAILED", "BLOCKED", "NEEDS_ATTENTION", "CANCELLED"],
    "rules": ["no_ai_may_self_certify_verified_complete", "workflow_success_is_not_publication_evidence", "generated_file_is_not_upload_evidence", "queue_status_is_not_publication_evidence", "external_evidence_must_match_exact_job_and_target", "review_gated_youtube_must_not_be_public_before_chairman_approval", "no_task_may_be_silently_dropped"]
  },
  "verification": {
    "web_publication": ["exact_target_identity", "public_url", "successful_http_response", "not_admin_preview_or_login", "not_404_or_error_placeholder", "expected_title_or_job_marker_when_available", "verification_timestamp"],
    "youtube_private": ["valid_video_id", "exact_channel_id", "privacy_status_private", "validated_studio_url", "job_bound_upload_receipt"],
    "youtube_public": ["valid_video_id", "exact_channel_id", "privacy_status_public", "youtube_api_retrieval_success", "verified_public_watch_url", "required_human_approval_if_review_gated"]
  },
  "runtime": {
