{
  "version": 1,
  "primary_site_id": "naver_n3",
  "active_site_ids": [
    "naver_n1",
    "naver_n2",
    "naver_n3"
  ],
  "timezone": "Asia/Seoul",
  "objective": "네이버 검색·홈 추천에서 신뢰를 쌓아 장기 방문과 합법적 수익 기회를 늘리되 방문자·순위·수익을 보장하지 않는다",
  "cadence": {
    "network_daily_min": 14,
    "network_daily_max": 18,
    "operating_window_kst": ["08:17", "23:17"],
    "random_non_round_minutes": true,
    "persist_daily_schedule_before_first_post": true,
    "never_bulk_publish": true,
    "skip_instead_of_lowering_quality": true
  },
  "morning_research": {
    "start_kst": "07:07",
    "deadline_kst": "07:50",
    "daily_brief_path": "data/naver-trend-brief/YYYY-MM-DD.json",
    "candidate_count": 30,
    "sources": [
      "Naver DataLab relative trend comparison",
      "Naver News freshness and repetition",
      "Naver search result intent",
      "Google Trends Korea directional signal",
      "primary official source"
    ],
    "dynamic_topic_families": [
      "스포츠·국제대회",
      "정치·정책",
      "영화·문화",
      "군사·안전",
      "국가지원금·지역보조금 변경",
      "지역별 열차·고속버스·공항버스"
    ],
    "replace_daily_plan_only_with_stronger_current_evidence": true,
    "never_claim_absolute_search_volume_without_measured_data": true
  },
  "monthly_keyword_catalog": {
    "path": "config/naver_monthly_keyword_100.json",
    "required_candidates_per_month": 100,
    "refresh_before_new_month_kst_day": 25,
    "all_candidates_require_same_day_validation": true
  },
  "per_site_cadence": {
    "naver_n1": {"display_name": "부의정석", "blog_id": "k-insight-vietnam", "daily_min": 3, "daily_max": 4, "minimum_interval_minutes": 180},
    "naver_n2": {"display_name": "헬스의정석", "blog_id": "health-standard", "daily_min": 3, "daily_max": 4, "minimum_interval_minutes": 180},
    "naver_n3": {"display_name": "생활의정석", "blog_id": "sky-only", "daily_min": 8, "daily_max": 10, "minimum_interval_minutes": 75}
  },
  "workflow": [
    "monthly_evergreen_keyword_rotation",
    "naver_datalab_relative_trend_research",
    "naver_news_freshness_check",
    "existing_search_entry_query_review",
    "official_source_verification",
    "original_title_and_body",
    "copyright_safe_original_image",
    "editorial_quality_review",
    "naver_editor_save_or_publish",
    "public_url_verification"
  ],
  "publishing": {
    "default": "public_after_editorial_review",
    "draft_save_supported": true,
    "require_public_url_verification": true,
    "owner_authorized_reviewed_public_posts": true,
    "search_follow_up": {
      "naver_public_url_verification": true,
      "naver_search_visibility_check": true,
      "google_search_console_only_when_property_ownership_is_verified": true,
      "google_indexing_api_for_general_blog_posts": false,
      "reason": "Google Indexing API is restricted to JobPosting and BroadcastEvent pages; a Naver-hosted blog URL must not be submitted as a general-article shortcut."
    }
  },
  "topics": {
    "priority": [
      "당일 검증된 네이버 인기 검색 의도",
      "스포츠·국제대회 일정과 결과",
      "정치·정부정책의 확인 가능한 변경",
      "영화·문화의 공식 일정과 흥행 정보",
      "군사·재난·지뢰 등 공공 안전 정보",
      "정책지원·생활혜택",
      "검색 수요가 있는 생활제도",
      "지역 맛집과 실제 방문 정보",
      "실용 쇼핑과 생활용품 비교",
      "저작권 안전한 문화·트렌드 해설"
    ],
    "blocked": [
      "확인되지 않은 연예 가십",
      "출처 없는 정치 주장·선거 예측·인물 비방",
      "확인되지 않은 군사정보·작전정보·위치정보",
      "영화 줄거리·기사·리뷰의 무단 복제",
      "허위 또는 종료된 지원금",
      "의학적 진단이나 치료 지시",
      "투자 수익 보장",
      "원문 짜깁기 또는 무단 사진",
      "제휴 표시 없는 광고성 링크"
    ]
  },
  "quality_gate": {
    "official_source_required_for_policy_posts": true,
    "minimum_body_chars": 1200,
    "duplicate_title_and_body_check": true,
    "natural_korean_edit_required": true,
    "ban_ai_meta_phrases": true,
    "image_count": 1,
    "source_attribution_required": true,
    "affiliate_disclosure_required": true,
    "maximum_exact_keyword_repetitions": 6,
    "official_deep_link_required_for_application_or_timetable_posts": true,
    "same_day_primary_source_required_for_politics_military_and_live_events": true,
    "movie_box_office_requires_kobis_or_distributor_source": true,
    "internal_related_link_max": 3,
    "search_result_link_must_not_replace_primary_source": true,
    "stale_timetable_numbers_forbidden": true,
    "unverified_search_volume_numbers_forbidden": true
  }
}
