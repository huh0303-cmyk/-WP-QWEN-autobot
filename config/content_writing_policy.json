{
  "version": "2026-11-14",
  "name": "MASTER_CONTENT_WRITING_ENGINE_POLICY",
  "status": "LOCKED_SINGLE_SOURCE_OF_TRUTH",
  "canonical_policy": "config/LONDON_PROJECT_UNIFIED_CONTENT_POLICY_20261114.json",
  "deprecated_policies": [
    "GPT-5 mini",
    "Gemini 2.5 Flash random",
    "legacy paid text fallback"
  ],
  "platforms": [
    "wordpress",
    "blogspot",
    "naver_blog",
    "tistory",
    "instagram",
    "threads",
    "facebook",
    "tiktok",
    "youtube"
  ],
  "writing": {
    "provider": "gemini",
    "free_only": true,
    "chains": {
      "en": [
        "gemini-3.6-flash",
        "gemini-3.5-flash",
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite",
        "gemini-2.0-flash",
        "gemini-3.8-flash"
      ],
      "ko": [
        "gemini-3.0-flash-lite",
        "gemini-3.1-flash-lite",
        "gemini-3.0-flash",
        "gemini-2.0-flash",
        "gemini-3.6-flash",
        "gemini-3.8-flash"
      ]
    },
    "failure": "cancel_publication"
  },
  "length": {
    "min_chars": 2500,
    "max_chars": 4000,
    "recommended_chars": [
      3000,
      3500
    ],
    "exclude": [
      "html",
      "whitespace",
      "affiliate_cards"
    ]
  },
  "images": {
    "max_images": 1,
    "free": [
      "pexels",
      "pixabay"
    ],
    "paid_fallback": [
      "sdxl-turbo",
      "flux-schnell"
    ],
    "free_order": "random_once_per_item",
    "duplicate_window_days": 14,
    "keys": [
      "url",
      "filename",
      "sha256"
    ],
    "featured_body_must_differ": true,
    "alt_required": true,
    "all_failed": "publish_without_image_and_record_failure"
  },
  "readability": {
    "components": [
      "accent_box",
      "left_color_line",
      "short_paragraphs",
      "divider",
      "faq_card"
    ],
    "font": "Noto Sans KR",
    "body_px": 17,
    "line_height": 1.8,
    "h2_px": 25,
    "h3_px": 19
  },
  "seo": {
    "title_duplicate": "block",
    "year_in_title": "forbid",
    "similarity_threshold": 0.85,
    "official_sources_for_sensitive_topics": true,
    "unique_meta_description": true,
    "internal_links": true
  },
  "logging": [
    "post_id",
    "url",
    "selected_model",
    "model_attempts",
    "body_char_count",
    "image_provider",
    "image_url",
    "image_duplicate_check",
    "image_failure_reason",
    "validation_result"
  ],
  "legacy_policy": "ignored"
}
