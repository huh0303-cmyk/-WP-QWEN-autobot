{
  "version": 4,
  "name": "MASTER_CONTENT_WRITING_ENGINE_POLICY",
  "status": "LOCKED",
  "scope": ["wordpress", "blogger", "tistory", "news", "youtube_scripts", "sns_copy"],
  "primary_writer": {
    "provider": "gemini",
    "model": "Gemini 2.5 Flash",
    "role": "first_draft_writer_for_all_content",
    "cost_policy": "free_tier_first",
    "rules": [
      "All first drafts are written by Gemini 2.5 Flash by default.",
      "Gemini must follow the site-specific persona, language, search intent, SEO structure, labels/categories and metadata rules.",
      "Do not silently upgrade to a paid Gemini tier when quota or authentication fails."
    ]
  },
  "fallback_writer": {
    "provider": "openai",
    "model_family": "ChatGPT/GPT",
    "role": "failed_draft_recovery_and_rewrite",
    "allowed_when": [
      "gemini_generation_failure",
      "gemini_quality_fail",
      "gemini_policy_or_format_fail",
      "important_content",
      "high_value_content",
      "manual_override"
    ],
    "rules": [
      "ChatGPT is the second-line writer, not the routine first-draft engine.",
      "When Gemini fails quality, factual, structural or formatting gates, ChatGPT rewrites the draft rather than automatically publishing it.",
      "No public publishing occurs from fallback output without the normal approval flow."
    ]
  },
  "auditor": {
    "provider": "openai",
    "model_family": "ChatGPT/GPT",
    "role": "independent_final_editorial_fact_and_quality_reviewer",
    "checks": [
      "grammar_and_spelling",
      "awkward_or_ai_sounding_phrasing",
      "readability_and_sentence_flow",
      "title_naturalness",
      "heading_structure",
      "repetition_and_template_pattern",
      "site_persona_and_tone_consistency",
      "search_intent_alignment",
      "metadata_label_category_consistency",
      "unsupported_or_suspicious_claims",
      "internal_contradictions",
      "final_quality_gate"
    ],
    "rules": [
      "GPT independently reviews and rewrites editorial problems after the Gemini draft; it is not the routine first-draft writer.",
      "GPT must not invent new facts while correcting grammar or style.",
      "Material factual uncertainty must be returned for source verification, not silently rewritten.",
      "A failed audit returns QUALITY_FAIL or REWRITE_REQUIRED and routes back to the writer before approval."
    ]
  },
  "pipeline": [
    "keyword_and_search_intent",
    "official_source_verification_when_required",
    "gemini_2_5_flash_first_draft",
    "quality_gate",
    "chatgpt_fallback_if_generation_or_quality_fails",
    "gemini_and_gpt_independent_review",
    "seo_and_metadata_validation",
    "draft_private_awaiting_approval"
  ],
  "freshness_sensitive_content": {
    "types": ["government_support", "benefits", "ticketing", "timetables", "application_deadlines", "policy_changes", "transport_schedules", "seasonal_events", "medical", "legal", "finance", "visa_immigration"],
    "official_source_verification_required": true,
    "on_missing_verification": "QUALITY_FAIL"
  },
  "human_editorial_style": {
    "forbid_model_or_prompt_mentions": true,
    "forbid_ai_process_disclosure_in_article_body": true,
    "forbid_repetitive_template_titles": true,
    "title_style": "emotionally resonant, curiosity-driving, benefit-led, specific, natural and accurate",
    "title_priority": "highest_text_priority",
    "first_image_priority": "equal_to_title_and_must_visualize_the_titles_specific_situation_emotion_and_benefit",
    "forbid_ai_sounding_title_formulas": true,
    "forbid_repeated_or_similar_titles": true,
    "forbid_clickbait_or_false_promises": true,
    "never_hide_sources_or_material_corrections": true
  },
  "golden_keyword_selection": {
    "applies_to": ["wordpress", "blogger", "tistory"],
    "news_exception": "two_newsrooms_use_latest_rss_headlines_as_reporting_topics",
    "policy_file": "config/golden_keyword_policy.json",
    "pipeline": ["current_news_media_terms", "event_entity_clustering", "google_naver_gsc_validation", "site_intent_conversion", "score_and_hard_gate"],
    "weights": {"gsc_demand": 25, "media_repetition": 20, "google_naver_trend": 20, "site_fit": 15, "actionable_search_intent": 10, "official_source_available": 10},
    "thresholds": {"candidate": 70, "priority": 80, "top": 90},
    "sensitive_topic_official_source_gate": "missing_source_means_hold_regardless_of_score",
    "missing_signal_rule": "zero_points_never_fabricate",
    "selection": "highest_verified_score_first_no_random_choice"
  },
  "cross_platform_originality": {
    "copy_paste_allowed": false,
    "forbid_reused_sentences_paragraphs_heading_order_examples_and_faq": true,
    "require_distinct_search_intent_title_outline_examples_and_faq_per_platform": true,
    "similar_or_repeated_title_action": "QUALITY_FAIL"
  },
  "quality_gate": {"minimum_score": 70, "below_minimum_action": "QUALITY_FAIL"},
  "two_model_checks_and_balances": {
    "status": "LOCKED_MANDATORY",
    "applies_to": ["wordpress", "blogger", "tistory", "news"],
    "gemini": "first_draft_and_independent_self_check",
    "gpt": "independent_fact_structure_seo_originality_check_and_rewrite_when_required",
    "approval_rule": "gemini_and_gpt_must_both_return_ok_true",
    "single_model_approval_allowed": false,
    "missing_or_failed_checker_action": "CONSENSUS_FAILED_NO_DRAFT"
  },
  "blogger_metadata": {
    "labels": {"minimum": 8, "maximum": 14, "count_mode": "varied_per_article", "format": "short_noun_search_terms", "sentences_forbidden": true},
    "search_description": {"required": true, "minimum_words": 100, "maximum_words": 120, "missing_or_out_of_range_action": "QUALITY_FAIL"}
  },
  "image_generation": {
    "maximum_images_per_content": 1,
    "order": ["Nano Banana only when explicitly confirmed free", "black-forest-labs/flux-schnell", "bytedance/sdxl-lightning-4step", "jyoung105/sdxl-turbo"],
    "attempts_per_model": 1,
    "all_failed_action": "no_image_no_substitute"
  },
  "safety": {
    "auto_public": false,
    "allowed_publish_states": ["draft", "private", "awaiting_approval"],
    "new_paid_service_without_approval": false,
    "silent_paid_tier_upgrade": false
  }
}
