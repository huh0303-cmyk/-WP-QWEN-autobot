{
  "project": "london-project",
  "timezone": "Asia/Seoul",
  "schedule_policy": {
    "planned_jitter_minutes": 60,
    "forbid_exact_hour": true,
    "avoid_regular_minute_multiples": [0,5,10,15,20,25,30,35,40,45,50,55],
    "minimum_same_platform_gap_minutes": 30,
    "avoid_repeating_same_day_time_pattern": true,
    "spread_targets_across_distinct_minutes": true,
    "no_same_slot_for_parallel_channels": true
  },
  "cadence": {
    "wordpress_general": {
      "scope": "each_enabled_general_wordpress_site",
      "target": "1_per_day",
      "weekly_target": 7,
      "randomized_time": true
    },
    "newsrooms": {
      "sites": ["The Seoul Journal", "Koreanews365"],
      "target": "1_per_day_per_newsroom",
      "weekly_target_per_newsroom": 7,
      "source_mode": "rss_and_breaking_news_event_driven",
      "minimum_requires_verified_source_leads": true,
      "never_invent_to_fill_minimum": true,
      "daily_max": 1,
      "separate_from_general_wordpress": true
    },
    "blogspot": {
      "target": "1_public_post_per_enabled_destination_per_day",
      "review_gated": false,
      "no_wordpress_copy_paste": true
    },
    "tistory": {
      "site_count": 5,
      "target": "1_public_post_per_enabled_site_per_day",
      "weekly_target_per_site": 7,
      "randomized_time": true,
      "public_requires_local_write_verification": true
    },
    "youtube_playlist": {
      "channel_count": 5,
      "weekly_min": 2,
      "weekly_max": 3,
      "target": "2_to_3_private_productions_per_channel_per_week",
      "randomize_weekly_days": true,
      "upload_default": "private",
      "human_review_before_public": true,
      "avoid_channel_time_collisions": true
    },
    "youtube_knowledge": {
      "channel_count": 5,
      "weekly_min": 2,
      "weekly_max": 3,
      "target": "2_to_3_private_productions_per_channel_per_week",
      "randomize_weekly_days": true,
      "upload_default": "private",
      "human_review_before_public": true,
      "avoid_channel_time_collisions": true
    },
    "survival_10_language": {
      "enabled": false,
      "status": "outside_locked_youtube_10_scope",
      "languages": ["Korean/TOPIK", "English", "Japanese", "Chinese", "Vietnamese", "Spanish", "French", "German", "Italian", "Portuguese"],
      "lessons_per_language": 50,
      "total_lessons": 500,
      "completed_through_lesson": 2,
      "next_lesson": 3,
      "target": "disabled_until_separately_approved",
      "upload_default": "private",
      "require_verified_private_before_review": true,
      "require_chairman_approval_before_public": true,
      "avoid_language_time_collisions": true,
      "spread_languages_across_distinct_slots": true
    },
    "instagram": {
      "target": "1_public_post_per_verified_account_per_day",
      "weekly_target": 7
    },
    "threads": {
      "target": "1_public_post_per_verified_account_per_day",
      "weekly_target": 7,
      "content_direction": "mirror_instagram_topic_not_verbatim_copy"
    },
    "tiktok": {
      "target": "1_public_post_per_verified_account_per_day",
      "weekly_target": 7
    },
    "facebook": {
      "target": "1_public_post_per_verified_account_per_day",
      "weekly_target": 7
    },
    "naver": {
      "target": "1_public_post_per_verified_account_per_day",
      "weekly_target": 7,
      "public_requires_local_write_verification": true
    }
  },
  "image_policy": {
    "copyright_safe_first": true,
    "order": ["pexels", "pixabay", "bytedance/sdxl-lightning-4step", "black-forest-labs/flux-schnell", "pass_without_image"],
    "relevance_check_required": true,
    "news_use_source_or_licensed_image_only": true,
    "never_copy_unlicensed_news_photo": true
  },
  "approval": {
    "youtube_private_state": "VERIFIED_PRIVATE",
    "human_review_state": "REVIEW_REQUIRED",
    "public_state_after_api_verification": "VERIFIED_COMPLETE",
    "never_public_without_human_approval": true
  },
  "activity_ledger": {
    "policy_file": "config/london_activity_policy.json",
    "every_task_must_be_recorded": true,
    "record_success_failure_retry_failover_and_evidence": true
  },
  "failover": {
    "plan_a": "codex_primary_pm",
    "plan_b": "claude_acting_pm",
    "plan_c": "gemini_continuity",
    "safe_hold": "preserve_queue_stop_new_generation_and_unapproved_publication"
  }
}
