{
  "version": 4,
  "scope": ["wordpress_27", "blogger_27", "youtube", "sns"],
  "provider": "replicate",
  "credential_secret": "REPLICATE_API_TOKEN",
  "enabled_when_provider_credentials_exist": false,
  "model_priority": [
    {
      "priority": 1,
      "model": "FLUX.1 Schnell",
      "model_id": "black-forest-labs/flux-schnell",
      "role": "primary",
      "license_gate": "Apache-2.0 or provider terms"
    },
    {
      "priority": 2,
      "model": "SDXL-Lightning 4-step",
      "model_id": "bytedance/sdxl-lightning-4step",
      "role": "low-cost fallback",
      "license_gate": "OpenRAIL++ and provider terms"
    },
    {
      "priority": 3,
      "model": "SDXL Turbo",
      "model_id": "jyoung105/sdxl-turbo",
      "role": "final generation fallback",
      "license_gate": "current Stability AI and provider commercial terms"
    }
  ],
  "hard_rules": {
    "require_article_or_video_topic_relevance": true,
    "allow_zero_images_when_all_candidates_fail": true,
    "images_per_article_min": 0,
    "images_per_article_max": 2,
    "free_stock_images_forbidden": true,
    "playlist_thumbnail_existing_frame_only": true,
    "thumbnail_video_generation_forbidden": true,
    "never_insert_generic_filler_image": true,
    "require_license_and_provider_cost_log": true,
    "forbid_fabricated_official_documents": true,
    "forbid_misleading_medical_legal_financial_evidence": true,
    "human_review_required_before_blogger_publication": true
  },
  "failure_policy": {
    "fallback_order": ["FLUX.1 Schnell", "SDXL-Lightning 4-step", "SDXL Turbo"],
    "fallback_to_free_stock": false,
    "fallback_to_generic_image": false,
    "when_all_generation_models_fail": "QUALITY_FAIL_OR_ZERO_IMAGE"
  },
  "notes": "MASTER IMAGE POLICY. For WordPress, Blogger, YouTube and SNS, generated images must route through Replicate in this strict order: FLUX.1 Schnell -> SDXL-Lightning 4-step -> SDXL Turbo. Free-stock and generic filler fallbacks remain forbidden. If all three generation models fail or results are irrelevant/unsafe, produce zero images or QUALITY_FAIL and send for review. Existing-frame-only exception remains for playlist thumbnails."
}
