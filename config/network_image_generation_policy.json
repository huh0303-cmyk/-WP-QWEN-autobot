{
  "version": 8,
  "scope": [
    "wordpress",
    "blogger",
    "tistory",
    "youtube_long_form",
    "youtube_shorts"
  ],
  "provider": "replicate",
  "credential_secret": "REPLICATE_API_TOKEN",
  "enabled_when_provider_credentials_exist": true,
  "model_priority": [
    {
      "priority": 1,
      "model": "Pexels",
      "model_id": "Pexels API",
      "role": "free stock image first",
      "estimated_cost_usd_per_image": 0
    },
    {
      "priority": 2,
      "model": "Pixabay",
      "model_id": "Pixabay API",
      "role": "free stock fallback",
      "estimated_cost_usd_per_image": 0
    },
    {
      "priority": 3,
      "model": "SDXL Turbo",
      "model_id": "bytonylee/sdxl-turbo",
      "role": "first paid fallback",
      "estimated_cost_usd_per_image": 0.0015
    },
    {
      "priority": 4,
      "model": "FLUX.1 Schnell",
      "model_id": "black-forest-labs/flux-schnell",
      "role": "second paid fallback",
      "estimated_cost_usd_per_image": 0.003
    }
  ],
  "hard_rules": {
    "require_article_or_video_topic_relevance": true,
    "allow_zero_images_when_all_candidates_fail": true,
    "images_per_article_min": 0,
    "images_per_article_max": 1,
    "free_stock_images_forbidden": false,
    "playlist_thumbnail_existing_frame_only": true,
    "thumbnail_video_generation_forbidden": true,
    "never_insert_generic_filler_image": true,
    "require_license_and_provider_cost_log": true,
    "forbid_fabricated_official_documents": true,
    "forbid_misleading_medical_legal_financial_evidence": true,
    "forbid_any_visible_generated_text": true,
    "forbid_illegible_pseudo_text_or_random_glyphs": true,
    "forbid_fake_hangul_chinese_japanese_characters": true,
    "avoid_documents_forms_screens_signs_labels_and_packaging": true,
    "text_or_pseudo_text_detection_action": "REMOVE_IMAGE_AND_CONTINUE_TEXT_ONLY",
    "human_review_required_before_blogger_publication": true,
    "require_stock_subject_metadata_match": true,
    "require_stock_self_hosting_and_credit": true,
    "one_output_per_paid_model_attempt": true,
    "max_attempts_per_paid_model_per_content": 1,
    "paid_generation_only_after_stock_miss": true,
    "testing_limit": "One output per paid model; no automatic retries",
    "forbid_sdxl_lightning": true,
    "forbid_flux_dev": true
  },
  "failure_policy": {
    "fallback_order": [
      "Pexels",
      "Pixabay",
      "SDXL Turbo",
      "FLUX.1 Schnell"
    ],
    "fallback_to_free_stock": false,
    "fallback_to_generic_image": false,
    "when_all_generation_models_fail": "PASS_AND_CONTINUE_WITH_ZERO_IMAGES"
  },
  "notes": "2026-11-10 user directive: use the same exact four-stage fallback for WordPress, Blogger/Blogspot, Tistory, YouTube long-form and Shorts: Pexels -> Pixabay -> SDXL Turbo -> FLUX.1 Schnell. Exclude SDXL Lightning, FLUX.1 [dev], and all other Replicate image models. One output and one attempt per paid model.",
  "stock_priority": [
    "Pexels",
    "Pixabay"
  ]
}
