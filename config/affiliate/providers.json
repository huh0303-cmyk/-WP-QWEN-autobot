{
  "version": 2,
  "description": "Only three affiliate providers are enabled by the current London Project standard.",
  "security": {
    "credentials_location": "GitHub Actions Secrets or local environment only",
    "never_commit_credentials": true,
    "never_invent_affiliate_urls": true,
    "never_publish_unverified_offers": true
  },
  "providers": [
    {
      "id": "coupang_partners",
      "name": "Coupang Partners",
      "status": "active",
      "adapter": "manual_portal",
      "allowed_affiliate_hosts": [
        "link.coupang.com"
      ],
      "catalog_scope": "per_site",
      "link_creation": "authenticated_partner_portal",
      "creative_source": "official_partner_portal_image_or_html",
      "product_cards_per_post": 10
    },
    {
      "id": "olive_young_global",
      "name": "Olive Young Global",
      "status": "active_header_button_only",
      "adapter": "account_reward_code",
      "allowed_affiliate_hosts": [
        "global.oliveyoung.com"
      ],
      "catalog_scope": "per_site",
      "link_creation": "account_reward_code_or_generated_reward_link",
      "product_cards_per_post": 0,
      "reward_code": "HUH556423"
    },
    {
      "id": "trip_com",
      "name": "Trip.com",
      "status": "active_header_button_and_category_links",
      "adapter": "account_generated_deeplink",
      "allowed_affiliate_hosts": [
        "trip.com",
        "www.trip.com"
      ],
      "catalog_scope": "per_site",
      "link_creation": "authenticated_affiliate_platform",
      "product_cards_per_post": 0,
      "categories": [
        "hotels",
        "flights",
        "tours_and_packages"
      ]
    }
  ],
  "disabled_providers": [
    {
      "id": "agoda",
      "status": "disabled_pending_site_approval"
    },
    {
      "id": "alibaba",
      "status": "disabled_not_in_current_standard"
    },
    {
      "id": "airbnb",
      "status": "disabled_not_in_current_standard"
    },
    {
      "id": "awin",
      "status": "disabled_not_in_current_standard"
    }
  ],
  "normalized_offer_fields": [
    "provider",
    "offer_id",
    "site_id",
    "title",
    "destination_url",
    "affiliate_url",
    "image_url",
    "category",
    "keywords",
    "currency",
    "price",
    "availability",
    "popularity_evidence",
    "creative_source",
    "verified"
  ],
  "selection": {
    "cards_per_post": 10,
    "card_provider": "coupang_partners",
    "selection": "best_article_relevance_plus_click_intent_and_price_mix",
    "provider_mix": "coupang_only_10",
    "site_catalog_isolation": true,
    "deduplicate_by": [
      "provider",
      "affiliate_url"
    ],
    "require_verified_tracking_link": true,
    "require_official_image": true
  }
}
