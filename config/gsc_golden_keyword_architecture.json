{
  "version": 1,
  "updated_on": "2026-09-18",
  "principle": "site-isolated GSC evidence -> Golden Keyword; one site failure never blocks another",
  "credentials": {
    "default_mode": "shared_readonly_service_account",
    "priority_dedicated_sites": [
      "https://k-health365.com"
    ],
    "note": "Credentials may be shared, but property/query/state/output are isolated per site."
  },
  "scoring": {
    "signals": [
      "gsc_impressions",
      "gsc_clicks",
      "gsc_ctr_opportunity",
      "gsc_position_opportunity",
      "freshness",
      "seasonality",
      "site_topic_fit",
      "commercial_intent"
    ],
    "penalties": [
      "existing_topic_similarity",
      "recent_keyword_use"
    ],
    "rule": "Never call GSC impressions market search volume. Prefer site-observed queries and long-tail expansion."
  },
  "isolation": {
    "per_site_state": true,
    "per_site_output": true,
    "continue_on_error": true,
    "max_retry": 1
  },
  "output_fields": [
    "site_id",
    "site_url",
    "category",
    "keyword",
    "intent",
    "gsc_clicks",
    "gsc_impressions",
    "gsc_ctr",
    "gsc_position",
    "priority",
    "used_at",
    "post_id",
    "post_url"
  ],
  "rollout": [
    "k-health365.com",
    "top-5 sites",
    "remaining WordPress sites",
    "Blogger companions"
  ]
}
