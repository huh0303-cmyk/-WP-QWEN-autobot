{
  "project": "london-project",
  "status": "LOCKED",
  "rule": "every_task_must_have_a_durable_trace",
  "task_id_required": true,
  "correlation_id_required": true,
  "record_from_request_to_terminal_state": true,
  "record_success_and_failure": true,
  "record_retries": true,
  "record_failover": true,
  "record_agent_assignment_changes": true,
  "record_external_evidence": true,
  "record_human_approval": true,
  "append_only_event_history": true,
  "storage": {
    "sqlite": "/opt/korea365/data/control-operations.sqlite3",
    "jsonl": "/opt/korea365/data/london_project_activity.jsonl",
    "report_json": "/opt/korea365/data/london_project_activity_report.json",
    "report_markdown": "/opt/korea365/data/london_project_activity_report.md"
  },
  "required_event_types": [
    "TASK_CREATED",
    "ASSIGNMENT_CHANGED",
    "STATE_CHANGED",
    "ATTEMPT",
    "FAILOVER",
    "EVIDENCE_ADDED",
    "HUMAN_APPROVAL",
    "AUDIT_RESULT"
  ],
  "terminal_states": ["VERIFIED_COMPLETE", "FAILED", "CANCELLED"],
  "verified_complete_authority": "deterministic_audit_engine",
  "no_silent_drop": true,
  "no_success_without_evidence": true
}
