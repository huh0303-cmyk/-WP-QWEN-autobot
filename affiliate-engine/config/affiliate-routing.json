  "selection_policy": {
    "objective": "maximize_confirmed_commission_per_qualified_visitor",
    "require_exact_provider_per_slot": true,
    "never_rank_by_commission_rate_alone": true,
    "no_invented_tracking_urls": true,
    "no_unverified_commission_claims": true,
    "no_unlicensed_images": true,
    "disclosure_required": true
  },
  "publishing_policy": {
    "wordpress": {
      "enabled": true,
      "preserve_existing_body": true,
      "preserve_existing_affiliate_links": true,
      "idempotency_key": "post_id+affiliate_engine_v3",
      "append_only": true
    },
    "blogger": {
      "enabled": true,
      "preserve_existing_body": true,
      "preserve_existing_affiliate_links": true,
      "idempotency_key": "blog_id+post_id+affiliate_engine_v3",
      "append_only": true,
      "rewrite_independently": true
    },
    "youtube": {
      "enabled": true,
      "destinations": [
        "description",
        "pinned_comment"
      ],
      "platform_policy_check": true
    },
    "tiktok": {
      "enabled": true,
      "destinations": [
        "profile_link",
        "supported_product_link"
      ],
      "account_feature_check": true
    }
  },
  "safety_gates": {
    "require_real_tracking_url": true,
    "require_image_source": true,
    "require_exactly_10_slots_before_publish": true,
    "dry_run_default": true,
    "bulk_write_requires_explicit_enable_flag": true,
    "never_delete_posts": true,
    "never_remove_existing_links": true,
    "require_exact_provider_allocation": true,
    "require_per_destination_catalog": true
  },
  "new_content_automation": {
    "enabled": true,
    "wordpress_and_blogger_only": true,
    "lookback_hours": 36,
    "backfill_batch_size_per_site": 5,
    "backfill_requires_manual_workflow_dispatch": true,
    "scheduled_mode": "dry_run",
    "manual_write_requires": "AFFILIATE_WRITE_ENABLED=true",
    "social_platforms": "separate_verified_adapters_required"
  },
  "rollout": {
    "pilot_site": "https://k-trip365.com",
    "pilot_published_posts_expected": 71,
    "pilot_batch_size": 5,
    "expand_after_verified_pilot": true,
    "wordpress_network": "inventory_required",
    "blogger_network": "blog_id_and_oauth_inventory_required"
  }
}
